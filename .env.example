# Opcional: copie para .env na raiz somente para personalizar o Docker Compose.
# Os padrões públicos abaixo servem apenas ao desenvolvimento local, nunca à produção.
PORTA_FRONTEND=5173
PORTA_BACKEND=3000
PORTA_POSTGRES=5433
POSTGRES_PASSWORD=vaggu_somente_desenvolvimento
CREDENTIAL_ENCRYPTION_KEY=vaggu-chave-publica-exclusiva-de-desenvolvimento
# Use letras/números/_/- na senha para inseri-la na URL sem codificação adicional.
# Mantenha senha e chave estáveis enquanto usar o mesmo volume; veja configuracao.md.
# Não altera a conexão do backend nativo: ela fica em vaggu-backend/.env.
# COMPOSE_PROJECT_NAME=vaggu
# VITE_WHATSAPP_NUMBER=
