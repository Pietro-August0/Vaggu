# Banco em arquivo local. Não exige usuário, senha ou servidor instalado.
DATABASE_URL="file:./prisma/dev.db"
PORT=3000
# Acesso apenas local nesta primeira etapa.
HOST=127.0.0.1
NODE_ENV=development

# WhatsApp Cloud API - placeholders, nunca coloque segredos reais em commits.
WHATSAPP_VERIFY_TOKEN="troque-por-um-token-de-verificacao"
META_APP_SECRET="troque-pelo-app-secret-da-meta"
WHATSAPP_ACCESS_TOKEN="troque-pelo-token-de-acesso"
WHATSAPP_PHONE_NUMBER_ID="troque-pelo-phone-number-id"
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_AUTO_REPLY_ENABLED=false
