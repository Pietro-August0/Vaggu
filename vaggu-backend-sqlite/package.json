{
  "name": "vaggu-backend",
  "version": "0.3.0",
  "private": true,
  "description": "Backend da Vaggu: JavaScript, Prisma, SQLite e autenticação.",
  "type": "module",
  "engines": { "node": ">=22.12.0 <25" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "admin:create": "node scripts/create-admin.js",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.3"
  }
}
