# Banco PostgreSQL persistente. Usar credenciais reais somente no arquivo .env .
DATABASE_URL="postgresql://vaggu:vaggu@localhost:5432/vaggu"
# Integração: definir separadamente, em .env.teste.local ou no ambiente do runner.
# O banco de controle deve terminar em _teste ou _test e o usuário precisa de CREATEDB.
# TEST_DATABASE_URL="postgresql://usuario:senha@127.0.0.1:5432/vaggu_teste"
PORT=3000
# Acesso apenas local nesta primeira etapa.
HOST=127.0.0.1
NODE_ENV=development

# WhatsApp Cloud API - placeholders, nunca coloque segredos reais em commits.
WHATSAPP_VERIFY_TOKEN="token-de-verificacao"
META_APP_SECRET="app-secret-da-meta"
WHATSAPP_ACCESS_TOKEN="token-de-acesso"
WHATSAPP_PHONE_NUMBER_ID="phone-number-id"
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_AUTO_REPLY_ENABLED=false
